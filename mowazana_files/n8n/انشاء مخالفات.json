    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\n// Collect all violator[N] keys dynamically\nconst violators = [];\nlet i = 0;\nwhile (body[`violator[${i}]`] !== undefined) {\n  violators.push(body[`violator[${i}]`]);\n  i++;\n}\n\n// Return one item per violator — this is what drives the loop\nreturn violators.map(id => ({\n  json: {\n    violator_id: id,\n    title: body.title,\n    amount: body.amount,\n    date: body.date,\n    description: body.description,\n    reason: body.reason,\n    image: body.image,\n    tr_status: body.tr_status,\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        112,
        192
      ],
      "id": "84c5084a-874b-4c75-a001-c3b5dc744fbc",
      "name": "code 1"
    },
    {
      "parameters": {
        "jsCode": "const violations = $items('code 1').map(item => item.json);\nconst users = $items('Get users').map(item => item.json);\n\nreturn violations.map(violation => {\n  const user = users.find(\n    u => String(u.user_id) === String(violation.violator_id)\n  );\n\n  return {\n    json: {\n      ...violation,\n      Name: user?.Name || null,\n      email: user?.email || null,\n      mobile: user?.mobile || null,\n    }\n  };\n});"
      },
