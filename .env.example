# WordPress source of truth. Use a dedicated service user with the
# `muwazana_api_access` capability and an Application Password.
WORDPRESS_BASE_URL=https://example.com
WORDPRESS_APP_USERNAME=muwazana-service
WORDPRESS_APP_PASSWORD=replace-with-application-password

# Generate at least 32 random bytes. Never expose this with NEXT_PUBLIC_.
SESSION_SECRET=replace-with-a-long-random-secret

# Optional for local or preview demonstrations. Never enable in production.
MUWAZANA_DEMO_MODE=false

# Public canonical URL used only for metadata and share previews.
NEXT_PUBLIC_APP_URL=https://app.example.com
