# Supabase project configuration. The service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
INITIAL_MANAGER_EMAILS=manager@example.com

# Optional for local demonstrations. Never enable in production.
MUWAZANA_DEMO_MODE=false

# Public canonical URL used only for metadata and share previews.
NEXT_PUBLIC_APP_URL=https://app.example.com
