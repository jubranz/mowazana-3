      "webhookId": "1c660f04-1dbd-44a5-a313-56457604222c"
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "chatId": "={{ $env.MUWAZANA_TELEGRAM_CHAT_ID }}",
        "message": "=طلب اعتماد سداد جديد\\nالعضو: {{ $json.body.data.member.name }}\\nالمبلغ: {{ $json.body.data.amount }} ريال\\nالنوع: {{ $json.body.data.type === 'loan_payment' ? 'سداد قسط' : 'سداد عام' }}\\nالتاريخ: {{ $json.body.data.date }}\\nملاحظة: {{ $json.body.data.note || '—' }}",
        "approvalOptions": {
          "values": {
            "approvalType": "double"
          }
        },
        "options": {
          "appendAttribution": false
        }
      },
      "id": "1bbf5b2c-eed4-4381-901e-d35291c5ef06",
