        "url": "={{ $env.MUWAZANA_WORDPRESS_URL }}/wp-json/muwazana/v1/transactions/{{ $('Webhook').item.json.body.data.type }}/{{ $('Webhook').item.json.body.data.id }}/reject",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ JSON.stringify({ reason: 'مرفوض من مسؤول الاعتماد عبر تيليجرام' }) }}",
