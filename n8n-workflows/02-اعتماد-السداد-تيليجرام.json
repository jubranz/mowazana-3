{
  "name": "موازنة — اعتماد السداد عبر تيليجرام",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mowazana-payment-approval",
        "responseMode": "onReceived",
        "authentication": "none",
        "options": {
          "onlyRunIf": "={{ $json.body.event === 'payment.created' }}"
        }
      },
