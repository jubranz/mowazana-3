      "typeVersion": 1.2,
      "position": [
        300,
        0
      ],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_TELEGRAM_CREDENTIAL",
          "name": "Telegram Mowazana bot"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "757fb8d5-9e71-4f58-b7f7-877e3af2d49e",
              "leftValue": "={{ $json.data.approved }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "dbb421f4-aef7-4037-8233-7092dc80c743",
      "name": "تمت الموافقة؟",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        600,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MUWAZANA_WORDPRESS_URL }}/wp-json/muwazana/v1/transactions/{{ $('Webhook').item.json.body.data.type }}/{{ $('Webhook').item.json.body.data.id }}/approve",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={}",
        "options": {}
      },
      "id": "c55fa808-17b2-45f2-ab25-2b5ea5d5a370",
